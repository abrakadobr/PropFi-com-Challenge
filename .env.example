# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_mgmt

# Backend
# PORT is partially hardcoded and is not recommended to change
PORT=5007
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/school_mgmt

# Backend - JWT
JWT_ACCESS_TOKEN_SECRET=docker_jwt_access_secret
JWT_REFRESH_TOKEN_SECRET=docker_jwt_refresh_secret
JWT_ACCESS_TOKEN_TIME_IN_MS=900000
JWT_REFRESH_TOKEN_TIME_IN_MS=28800000

# Backend - CSRF
CSRF_TOKEN_SECRET=docker_csrf_secret
CSRF_TOKEN_TIME_IN_MS=950000

# Backend - Email
MAIL_FROM_USER=noreply@school-admin.com
RESEND_API_KEY=re_placeholder

# Backend - Email Verification
EMAIL_VERIFICATION_TOKEN_SECRET=docker_email_verification_secret
EMAIL_VERIFICATION_TOKEN_TIME_IN_MS=18000000

# Backend - Password Setup
PASSWORD_SETUP_TOKEN_SECRET=docker_password_setup_secret
PASSWORD_SETUP_TOKEN_TIME_IN_MS=300000

# Backend - URLs / Cookie / Environment
UI_URL=http://localhost:5173
API_URL=http://localhost:5007
COOKIE_DOMAIN=localhost
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:5007

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pgadmin.com
PGADMIN_DEFAULT_PASSWORD=secret
